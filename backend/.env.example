NODE_ENV=development
PORT=3000

# HLS channel folders (relative to backend root; each folder holds playlist.m3u8 + .ts)
CHANNEL_1_PATH=channels/channel-1
CHANNEL_2_PATH=channels/channel-2
CHANNEL_3_PATH=channels/channel-3

# deployment FTP credentials
FTP_HOST=ftp.server.com
FTP_USER=user
FTP_PASSWORD=pwd
FTP_PORT=21
FTP_SECURE=false
FTP_REMOTE_PATH=/

